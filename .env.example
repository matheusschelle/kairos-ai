# Higgsfield API — geração de vídeo e imagem
# Crie suas credenciais em: https://console.higgsfield.ai
# Formato no header: Authorization: Key {HF_API_KEY_ID}:{HF_API_KEY_SECRET}
#
# ATENÇÃO: este projeto é um PWA puro (client-side). As chaves são salvas
# no localStorage do dispositivo e usadas diretamente pelo browser.
# A documentação oficial da Higgsfield recomenda uso server-side.
# Para produção com múltiplos usuários, considere um proxy backend.
#
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# --- Outras chaves usadas na app (referência) ---
# Groq (chat/STT): https://console.groq.com
GROQ_API_KEY=

# ElevenLabs (TTS premium): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Serper.dev (busca web): https://serper.dev
SERPER_API_KEY=
